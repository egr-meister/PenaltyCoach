<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data transfer rules. Cloud backup and device-to-device
  transfer are allowed for the local DataStore file only. No sensitive data
  (there is no account or token stored on device) is involved.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
